# Producción en servidor (copiar a .env en el VPS)
SECRET_KEY=CAMBIAR-generar-con-python-secrets-token-urlsafe-50
FLASK_ENV=production
ALLOW_REGISTRATION=false
SESSION_COOKIE_SECURE=true

# Opcional: dominio propio (HTTPS automático con Caddy)
# Si no tenés dominio, dejá vacío y entrás por http://IP-DEL-SERVIDOR
DOMAIN=

# Puerto interno (no cambiar salvo conflicto)
PORT=8000
