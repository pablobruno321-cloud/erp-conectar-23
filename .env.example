# Copia este archivo a .env y llena los valores
# NO commits .env a GitHub (ya está en .gitignore)

# Clave secreta de Flask (genera con: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=tu-clave-secreta-super-larga-aqui

# Entorno: development o production
FLASK_ENV=development

# Servidor (producción)
HOST=0.0.0.0
PORT=5000

# Registro público: en producción dejar en false (el admin crea usuarios)
ALLOW_REGISTRATION=false

# Cookies seguras detrás de HTTPS (Cloudflare / nginx). En HTTP local poner false
SESSION_COOKIE_SECURE=true

# Base de datos
# Local: no hace falta DATABASE_URL (usa erp_app/erp.db)
# Render + Neon gratis:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require